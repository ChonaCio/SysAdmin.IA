# Copy to .env for local development (python -m app). On an installed server the
# config lives in /etc/sysadmin-ia/sysadmin-ia.env instead.
ANTHROPIC_API_KEY=
SAI_HOST=127.0.0.1
SAI_PORT=8765
SAI_MODEL=claude-opus-5-5
SAI_EFFORT=high
SAI_SECRET_KEY=change-me-to-a-long-random-string
# SAI_TLS_CERT=/path/to/cert.pem
# SAI_TLS_KEY=/path/to/key.pem
# Self-update source; a token is only needed if the repository is private.
# SAI_UPDATE_REPO=ChonaCio/SysAdmin.IA
# SAI_UPDATE_BRANCH=main
# SAI_GITHUB_TOKEN=
