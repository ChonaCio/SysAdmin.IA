#!/usr/bin/env bash
# SysAdmin.IA – root helper (server name, reboot, full upgrades).
#
# install.sh copies this to /usr/local/sbin/sysadmin-ia-hostname (root-owned) and lets the
# service user run it through a narrow sudoers rule, so the web UI can rename the server,
# reboot it and install updates even without "full access". It only does the following:
#
#   sysadmin-ia-hostname upgrade REF VERSION
#                                   download REF (tag, branch or commit) of the configured
#                                   GitHub repository (SAI_UPDATE_REPO in the root-owned
#                                   config file, never chosen by the caller) and run its
#                                   install.sh non-interactively, in the background; rolls
#                                   back if the app does not come up. An optional GitHub
#                                   token is read from stdin. Progress:
#                                   /var/log/sysadmin-ia/upgrade.{status,log}
#   sysadmin-ia-hostname set NAME   set the hostname, /etc/hosts entry, re-announce it on the
#                                   LAN via mDNS (NAME.local) and refresh the TLS certificate
#   sysadmin-ia-hostname cert       create/refresh the self-signed certificate so it covers
#                                   the current name and IP addresses
#   sysadmin-ia-hostname status     print the name and LAN-discovery state (no changes)
#   sysadmin-ia-hostname reboot     reboot the server (after a few seconds)
#   sysadmin-ia-hostname mount DEV NAME [--persist] [--readonly]
#                                   mount block device DEV at /mnt/NAME (nosuid,nodev; FAT/
#                                   exFAT/NTFS owned by the service user); --persist adds an
#                                   /etc/fstab entry (by UUID, nofail) so it mounts at boot
#   sysadmin-ia-hostname unmount DIR [--forget]
#                                   unmount DIR (only under /mnt, /media, /run/media);
#                                   --forget also removes the fstab entry this helper added
#   sysadmin-ia-hostname install    install/refresh this helper in /usr/local/sbin and the
#                                   sudoers rule that lets the service user run it; e.g.
#                                   sudo bash /opt/sysadmin-ia/scripts/sysadmin-ia-hostname install
set -euo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

APP_NAME="sysadmin-ia"
SVC_USER="sysadmin-ia"
CONF_DIR="/etc/${APP_NAME}"
ENV_FILE="${CONF_DIR}/sysadmin-ia.env"
TLS_DIR="${CONF_DIR}/tls"
CERT="${TLS_DIR}/cert.pem"
KEY="${TLS_DIR}/key.pem"
MARK="SysAdmin.IA self-signed"
AVAHI_SERVICE="/etc/avahi/services/${APP_NAME}.service"

die() { echo "ERROR: $*" >&2; exit 1; }
[[ $EUID -eq 0 ]] || die "must run as root"

valid_name() { [[ "$1" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] && [[ ! "$1" =~ ^[0-9]+$ ]]; }

lan_ips() { hostname -I 2>/dev/null | tr ' ' '\n' | grep -v ':' | grep -v '^$' || true; }

env_value() { [[ -f "$ENV_FILE" ]] && sed -n "s/^$1=//p" "$ENV_FILE" | tail -1 || true; }

# ---------------------------------------------------------------- TLS certificate
# Only the certificate install.sh generated is managed here; a certificate you installed
# yourself (other path, or not created by SysAdmin.IA) is never touched.
cert_is_ours() {
  [[ -f "$CERT" ]] || return 1
  local subj issuer
  subj="$(openssl x509 -in "$CERT" -noout -subject 2>/dev/null)" || return 1
  issuer="$(openssl x509 -in "$CERT" -noout -issuer 2>/dev/null)" || return 1
  [[ "$subj" == *"$MARK"* ]] && return 0
  # Certificates from older installers: self-signed with only a CN.
  [[ "${subj#subject=}" == "${issuer#issuer=}" && "$subj" =~ ^subject=\ ?CN\ ?=\ ?[^,/]+$ ]]
}

cert_covers() {  # cert_covers "DNS:a,DNS:b,IP:1.2.3.4"
  local san item
  san="$(openssl x509 -in "$CERT" -noout -text 2>/dev/null | grep -A1 'Subject Alternative Name' | tail -1 | tr -d ' ')"
  san="${san//IPAddress:/IP:}"
  IFS=, read -ra items <<<"$1"
  for item in "${items[@]}"; do [[ ",${san}," == *",${item},"* ]] || return 1; done
}

do_cert() {
  [[ "$(env_value SAI_TLS_CERT)" == "$CERT" ]] || { echo "TLS: not using ${CERT}; certificate left alone."; return 0; }
  local name fqdn san ip
  name="$(hostname -s 2>/dev/null || hostname)"
  fqdn="$(hostname -f 2>/dev/null || echo "$name")"
  san="DNS:${name},DNS:${name}.local,DNS:localhost,IP:127.0.0.1"
  [[ "$fqdn" != "$name" && "$fqdn" != localhost* ]] && san="DNS:${fqdn},${san}"
  for ip in $(lan_ips); do san="${san},IP:${ip}"; done

  if [[ -f "$CERT" ]]; then
    if ! cert_is_ours; then echo "TLS: ${CERT} is not a SysAdmin.IA self-signed certificate; left alone."; return 0; fi
    if cert_covers "$san"; then echo "TLS: certificate already covers ${name} and ${name}.local."; return 0; fi
  fi
  mkdir -p "$TLS_DIR"
  openssl req -x509 -newkey rsa:2048 -nodes -days 825 -sha256 \
    -keyout "${KEY}.new" -out "${CERT}.new" \
    -subj "/O=${MARK}/CN=${name}.local" -addext "subjectAltName=${san}" >/dev/null 2>&1 \
    || die "openssl could not create the certificate"
  mv "${KEY}.new" "$KEY"; mv "${CERT}.new" "$CERT"
  chown -R root:"$SVC_USER" "$TLS_DIR"; chmod 750 "$TLS_DIR"; chmod 640 "$TLS_DIR"/*.pem
  echo "TLS: new self-signed certificate for ${name}.local (${san}). Browsers will warn once more."
  echo "CERT_CHANGED"
}

# ---------------------------------------------------------------- mDNS (Avahi)
write_avahi_service() {
  [[ -d /etc/avahi/services ]] || return 0
  local port scheme
  port="$(env_value SAI_PORT)"; port="${port:-8765}"
  scheme=http; [[ -n "$(env_value SAI_TLS_CERT)" ]] && scheme=https
  cat > "$AVAHI_SERVICE" <<EOF
<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Written by SysAdmin.IA: advertises the web UI on the LAN. -->
<service-group>
  <name replace-wildcards="yes">SysAdmin.IA on %h</name>
  <service>
    <type>_${scheme}._tcp</type>
    <port>${port}</port>
    <txt-record>path=/</txt-record>
  </service>
</service-group>
EOF
}

reannounce() {
  if command -v avahi-daemon >/dev/null; then
    write_avahi_service
    if command -v systemctl >/dev/null && [[ -d /run/systemd/system ]]; then
      systemctl enable avahi-daemon >/dev/null 2>&1 || true
      systemctl restart avahi-daemon >/dev/null 2>&1 || echo "mDNS: could not restart avahi-daemon."
    elif command -v rc-service >/dev/null; then
      rc-service avahi-daemon restart >/dev/null 2>&1 || true
    fi
    echo "mDNS: announcing $(hostname -s 2>/dev/null || hostname).local on the LAN."
  else
    echo "mDNS: avahi-daemon is not installed, so NAME.local will not resolve. Re-run install.sh to add it."
  fi
}

# ---------------------------------------------------------------- hostname
do_set() {
  local new="${1,,}" old
  valid_name "$new" || die "invalid name '$1': use 1-63 letters, digits and hyphens (not starting/ending with a hyphen)"
  old="$(hostname -s 2>/dev/null || hostname)"
  if command -v hostnamectl >/dev/null && [[ -d /run/systemd/system ]]; then
    hostnamectl set-hostname "$new"
  else
    echo "$new" > /etc/hostname
    hostname "$new"
  fi
  # /etc/hosts: keep the name resolvable locally (Debian-style 127.0.1.1 entry).
  if grep -qE '^127\.0\.1\.1[[:space:]]' /etc/hosts; then
    sed -i -E "s/^127\.0\.1\.1[[:space:]].*/127.0.1.1\t${new}.local ${new}/" /etc/hosts
  else
    printf '127.0.1.1\t%s.local %s\n' "$new" "$new" >> /etc/hosts
  fi
  echo "Hostname: ${old} -> ${new}"
  reannounce
  do_cert
}

do_status() {
  local name avahi=missing
  name="$(hostname -s 2>/dev/null || hostname)"
  if command -v avahi-daemon >/dev/null; then
    avahi=installed
    if command -v systemctl >/dev/null && systemctl is-active --quiet avahi-daemon 2>/dev/null; then avahi=active; fi
  fi
  echo "name=${name}"
  echo "avahi=${avahi}"
  echo "ips=$(lan_ips | tr '\n' ' ')"
}

INSTALLED="/usr/local/sbin/${APP_NAME}-hostname"
SUDOERS_RULE="/etc/sudoers.d/${APP_NAME}-hostname"

# ---------------------------------------------------------------- full upgrade
# Everything an upgrade needs is done by the new version's own install.sh, exactly as when
# installing it by hand: packages (e.g. avahi), the systemd unit, this helper, sudoers rules,
# the CLI wrapper, the virtualenv and the app code. Config, data and users are kept.
PREFIX="/opt/${APP_NAME}"
DATA_DIR="/var/lib/${APP_NAME}"
LOG_DIR="/var/log/${APP_NAME}"          # root-owned: the service user can read, not write
UPG_LOG="${LOG_DIR}/upgrade.log"
UPG_STATUS="${LOG_DIR}/upgrade.status"
UPG_TOKEN="${LOG_DIR}/.upgrade-token"

valid_ref()     { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,99}$ && "$1" != *..* ]]; }
valid_version() { [[ "$1" =~ ^[0-9]+(\.[0-9]+){0,3}$ ]]; }
valid_repo()    { [[ "$1" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; }

as_svc() {
  if command -v runuser >/dev/null; then runuser -u "$SVC_USER" -- env HOME="$DATA_DIR" "$@"
  else sudo -u "$SVC_USER" -- env HOME="$DATA_DIR" "$@"; fi
}

upg_status() {  # upg_status STATE VERSION MESSAGE
  printf 'state=%s\nversion=%s\nupdated=%s\nmessage=%s\n' "$1" "$2" "$(date +%s)" "$3" > "${UPG_STATUS}.tmp"
  chown root:"$SVC_USER" "${UPG_STATUS}.tmp"; chmod 640 "${UPG_STATUS}.tmp"
  mv "${UPG_STATUS}.tmp" "$UPG_STATUS"
}

prepare_log_dir() {
  mkdir -p "$LOG_DIR"
  chown root:"$SVC_USER" "$LOG_DIR"; chmod 750 "$LOG_DIR"
}

do_upgrade() {  # upgrade REF VERSION   (GitHub token, optional, on stdin)
  local ref="$1" version="$2" tok="" state="" updated=0
  valid_ref "$ref" || die "invalid ref"
  valid_version "$version" || die "invalid version"
  prepare_log_dir
  if [[ -f "$UPG_STATUS" ]]; then
    state="$(sed -n 's/^state=//p' "$UPG_STATUS")"; updated="$(sed -n 's/^updated=//p' "$UPG_STATUS")"
    if [[ "$state" == running && $(( $(date +%s) - ${updated:-0} )) -lt 1800 ]]; then
      die "an upgrade is already running"
    fi
  fi
  if [[ ! -t 0 ]]; then IFS= read -r -t 5 tok || true; fi
  rm -f "$UPG_TOKEN"
  if [[ -n "$tok" ]]; then
    [[ ${#tok} -le 255 && ! "$tok" =~ [[:space:]] ]] || die "invalid token"
    (umask 077; printf '%s' "$tok" > "$UPG_TOKEN")
  fi
  : > "$UPG_LOG"; chown root:"$SVC_USER" "$UPG_LOG"; chmod 640 "$UPG_LOG"
  upg_status running "$version" "Starting"
  # Run detached from the web app: install.sh restarts the app's service, which would
  # otherwise kill this process half-way.
  local self; self="$(readlink -f "${BASH_SOURCE[0]}")"
  if command -v systemd-run >/dev/null && [[ -d /run/systemd/system ]]; then
    systemd-run --quiet --collect --unit="${APP_NAME}-upgrade-$(date +%s)" \
      /bin/bash "$self" _upgrade-run "$ref" "$version"
  else
    nohup setsid /bin/bash "$self" _upgrade-run "$ref" "$version" >/dev/null 2>&1 &
  fi
  echo "Upgrade to ${version} started."
}

do_upgrade_run() {  # _upgrade-run REF VERSION   (the background part)
  local ref="$1" version="$2" repo tok="" work root snap="" host port ok=0 i
  valid_ref "$ref" || die "invalid ref"
  valid_version "$version" || die "invalid version"
  prepare_log_dir
  exec >>"$UPG_LOG" 2>&1
  set -E
  trap 'upg_status failed "$version" "Unexpected error; see ${UPG_LOG}"' ERR
  echo "==> $(date -Is) Upgrading SysAdmin.IA to ${version} (${ref})"

  repo="$(env_value SAI_UPDATE_REPO)"; repo="${repo:-ChonaCio/SysAdmin.IA}"
  valid_repo "$repo" || { upg_status failed "$version" "Invalid SAI_UPDATE_REPO"; die "invalid SAI_UPDATE_REPO"; }
  tok="$(env_value SAI_GITHUB_TOKEN)"
  if [[ -f "$UPG_TOKEN" ]]; then tok="$(cat "$UPG_TOKEN")"; rm -f "$UPG_TOKEN"; fi

  work="$(mktemp -d)"
  trap 'rm -rf "$work"' EXIT
  upg_status running "$version" "Downloading"
  echo "==> Downloading github.com/${repo} @ ${ref}"
  if ! GH_TOKEN="$tok" python3 -I -c '
import os, sys, urllib.request
req = urllib.request.Request(sys.argv[1], headers={"User-Agent": "SysAdmin.IA-updater",
                                                   "Accept": "application/vnd.github+json"})
if os.environ.get("GH_TOKEN"):
    req.add_unredirected_header("Authorization", "Bearer " + os.environ["GH_TOKEN"])
size = 0
with urllib.request.urlopen(req, timeout=120) as r, open(sys.argv[2], "wb") as f:
    while chunk := r.read(1 << 20):
        size += len(chunk)
        if size > 50 * 1024 * 1024:
            sys.exit("download too large")
        f.write(chunk)
' "https://api.github.com/repos/${repo}/tarball/${ref}" "${work}/src.tar.gz"; then
    upg_status failed "$version" "Download failed"; die "download failed"
  fi
  mkdir "${work}/src"
  tar -xzf "${work}/src.tar.gz" -C "${work}/src" --no-same-owner --no-same-permissions \
    || { upg_status failed "$version" "Could not unpack the download"; die "unpack failed"; }
  root="$(find "${work}/src" -mindepth 1 -maxdepth 1 -type d | head -1)"
  if [[ -z "$root" || ! -f "${root}/install.sh" || ! -f "${root}/app/main.py" ]]; then
    upg_status failed "$version" "The download does not look like SysAdmin.IA"; die "bad archive"
  fi
  chmod -R u+rwX,go+rX "$root"
  # Tags/releases may not bump VERSION themselves; record the version being installed.
  echo "$version" > "${root}/VERSION"

  if [[ -d "${PREFIX}/.git" ]]; then
    as_svc git -C "$PREFIX" add -A >/dev/null 2>&1 || true
    as_svc git -C "$PREFIX" commit -qm "Snapshot before update to ${version} $(date -Is)" >/dev/null 2>&1 || true
    snap="$(as_svc git -C "$PREFIX" rev-parse HEAD 2>/dev/null || true)"
  fi

  upg_status running "$version" "Running install.sh"
  echo "==> Running install.sh -y"
  if (cd "$root" && bash ./install.sh -y); then
    upg_status running "$version" "Waiting for the app to start"
    host="$(env_value SAI_HOST)"; port="$(env_value SAI_PORT)"; port="${port:-8765}"
    [[ -z "$host" || "$host" == 0.0.0.0 || "$host" == "::" ]] && host=127.0.0.1
    for i in $(seq 1 45); do
      if (exec 3<>"/dev/tcp/${host}/${port}") 2>/dev/null; then ok=1; break; fi
      sleep 2
    done
  fi

  if [[ $ok -eq 1 ]]; then
    echo "==> $(date -Is) Upgrade to ${version} finished."
    upg_status done "$version" "Updated to ${version}"
    return 0
  fi
  echo "==> The new version did not start; rolling back."
  if [[ -n "$snap" ]]; then
    as_svc git -C "$PREFIX" reset -q --hard "$snap" || true
    as_svc "${PREFIX}/.venv/bin/pip" install -q -r "${PREFIX}/requirements.txt" || true
  fi
  systemctl restart "$APP_NAME" 2>/dev/null || true
  upg_status failed "$version" "The update failed and was rolled back; see ${UPG_LOG}"
  return 1
}

do_install() {
  local self
  self="$(readlink -f "${BASH_SOURCE[0]}")"
  if [[ "$self" != "$INSTALLED" ]]; then
    install -o root -g root -m 755 "$self" "${INSTALLED}.new"
    mv "${INSTALLED}.new" "$INSTALLED"
  fi
  mkdir -p /etc/sudoers.d
  echo "$SVC_USER ALL=(root) NOPASSWD: $INSTALLED" > "${SUDOERS_RULE}.tmp"
  chmod 440 "${SUDOERS_RULE}.tmp"
  if visudo -cf "${SUDOERS_RULE}.tmp" >/dev/null; then
    mv "${SUDOERS_RULE}.tmp" "$SUDOERS_RULE"
  else
    rm -f "${SUDOERS_RULE}.tmp"; die "sudoers validation failed"
  fi
  echo "Installed ${INSTALLED}; '${SVC_USER}' may run it with sudo."
}

do_reboot() {
  echo "Rebooting in 3 seconds."
  # Detached, so the caller (the web app) can still send its reply before shutdown.
  if command -v systemd-run >/dev/null && [[ -d /run/systemd/system ]]; then
    systemd-run --quiet --on-active=3 --timer-property=AccuracySec=100ms /bin/systemctl reboot \
      || nohup sh -c 'sleep 3; systemctl reboot' >/dev/null 2>&1 &
  else
    nohup sh -c 'sleep 3; reboot' >/dev/null 2>&1 &
  fi
}

# ---------------------------------------------------------------- drives
MOUNT_BASE="/mnt"
MOUNTABLE_FS=" ext2 ext3 ext4 xfs btrfs vfat exfat ntfs ntfs3 f2fs iso9660 udf hfsplus jfs reiserfs "
# Entries this helper adds to /etc/fstab are preceded by this exact comment line.
fstab_mark() { printf '# added by SysAdmin.IA: %s' "$1"; }
fstab_has() { grep -qxF "$(fstab_mark "$1")" /etc/fstab; }
fstab_drop() {  # remove the marker line for mount point $1 and the entry right after it
  local tmp
  tmp="$(mktemp)"
  awk -v m="$(fstab_mark "$1")" '$0 == m { skip = 1; next } skip { skip = 0; next } { print }' /etc/fstab > "$tmp"
  cat "$tmp" > /etc/fstab   # keep the file's owner and permissions
  rm -f "$tmp"
}

do_mount() {  # mount DEV NAME [--persist] [--readonly]
  local dev="$1" name="$2" persist=0 ro=0 fstype uuid target opts uid gid line
  shift 2
  for a in "$@"; do
    case "$a" in --persist) persist=1 ;; --readonly) ro=1 ;; *) die "unknown option $a" ;; esac
  done
  [[ "$dev" =~ ^/dev/[A-Za-z0-9/_.:-]+$ && "$dev" != *..* ]] || die "invalid device"
  [[ -b "$dev" ]] || die "$dev is not a block device"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die "invalid name"
  if findmnt -rn -S "$dev" >/dev/null 2>&1; then die "$dev is already mounted"; fi
  fstype="$(blkid -o value -s TYPE "$dev" 2>/dev/null || true)"
  [[ -n "$fstype" && "$MOUNTABLE_FS" == *" $fstype "* ]] || die "unsupported or missing filesystem '${fstype:-none}'"
  uuid="$(blkid -o value -s UUID "$dev" 2>/dev/null || true)"
  target="${MOUNT_BASE}/${name}"
  if [[ -e "$target" ]]; then
    [[ -d "$target" && ! -L "$target" ]] || die "$target exists and is not a folder"
    mountpoint -q "$target" && die "$target is already in use"
    [[ -z "$(ls -A "$target")" ]] || die "$target is not empty"
  fi
  mkdir -p "$target"

  opts="nosuid,nodev"
  [[ $ro -eq 1 ]] && opts="${opts},ro"
  case "$fstype" in
    vfat|exfat|ntfs|ntfs3)
      # No Unix permissions on these: give the files to the service user, readable by all.
      uid="$(id -u "$SVC_USER")"; gid="$(id -g "$SVC_USER")"
      opts="${opts},uid=${uid},gid=${gid},umask=0022"
      ;;
  esac
  local mtype="$fstype"
  if [[ "$fstype" == ntfs ]] && grep -qw ntfs3 /proc/filesystems 2>/dev/null; then mtype=ntfs3; fi
  if ! mount -t "$mtype" -o "$opts" "$dev" "$target" 2>&1; then
    rmdir "$target" 2>/dev/null || true
    die "mount failed"
  fi
  echo "Mounted ${dev} (${fstype}) at ${target}."

  if [[ $persist -eq 1 ]]; then
    if [[ -z "$uuid" ]]; then
      echo "Not added to /etc/fstab: the volume has no UUID."
    else
      cp -p /etc/fstab "/etc/fstab.sysadmin-ia.bak"
      # Remove an older entry of ours for the same mount point, then add the new one.
      fstab_drop "$target"
      line="UUID=${uuid} ${target} ${mtype} ${opts},nofail,x-systemd.device-timeout=10s 0 0"
      # Make sure the file ends with a newline before appending.
      [[ -s /etc/fstab && -n "$(tail -c1 /etc/fstab)" ]] && echo >> /etc/fstab
      printf '%s\n%s\n' "$(fstab_mark "$target")" "$line" >> /etc/fstab
      command -v systemctl >/dev/null && systemctl daemon-reload 2>/dev/null || true
      echo "Added to /etc/fstab: it will be mounted automatically at startup."
    fi
  fi
}

do_unmount() {  # unmount DIR [--forget]
  local dir="$1" forget=0 real
  shift
  for a in "$@"; do
    case "$a" in --forget) forget=1 ;; *) die "unknown option $a" ;; esac
  done
  real="$(readlink -f "$dir" 2>/dev/null || true)"
  case "$real" in
    /mnt/?*|/media/?*|/run/media/?*) ;;
    *) die "only drives under /mnt, /media or /run/media can be unmounted here" ;;
  esac
  mountpoint -q "$real" || die "$real is not mounted"
  sync
  if ! umount "$real" 2>&1; then
    echo "Programs still using it:"; (command -v fuser >/dev/null && fuser -vm "$real" 2>&1 | head -20) || true
    die "the drive is busy: close files or programs that use it (including console sessions in that folder) and try again"
  fi
  echo "Unmounted ${real}. It is now safe to remove the drive."
  if [[ $forget -eq 1 ]] && fstab_has "$real"; then
    cp -p /etc/fstab "/etc/fstab.sysadmin-ia.bak"
    fstab_drop "$real"
    command -v systemctl >/dev/null && systemctl daemon-reload 2>/dev/null || true
    echo "Removed from /etc/fstab (it won't be mounted at startup)."
  fi
  # Remove the empty folder we created under /mnt.
  [[ "$real" == /mnt/* && -d "$real" && -z "$(ls -A "$real")" ]] && rmdir "$real" || true
}

case "${1:-}" in
  mount)   [[ $# -ge 3 ]] || die "usage: $0 mount DEV NAME [--persist] [--readonly]"; shift; do_mount "$@" ;;
  unmount) [[ $# -ge 2 ]] || die "usage: $0 unmount DIR [--forget]"; shift; do_unmount "$@" ;;
  set)     [[ $# -eq 2 ]] || die "usage: $0 set NAME"; do_set "$2" ;;
  cert)    do_cert ;;
  mdns)    reannounce ;;
  status)  do_status ;;
  reboot)  do_reboot ;;
  install) do_install ;;
  upgrade) [[ $# -eq 3 ]] || die "usage: $0 upgrade REF VERSION"; do_upgrade "$2" "$3" ;;
  _upgrade-run) [[ $# -eq 3 ]] || die "usage: $0 _upgrade-run REF VERSION"; do_upgrade_run "$2" "$3" ;;
  *)       die "usage: $0 {set NAME|cert|mdns|status|reboot|install|upgrade REF VERSION|mount DEV NAME|unmount DIR}" ;;
esac
